@startuml
skinparam linetype ortho

entity Bien {
    bien_id (PK)
    ---
    subcategoria_id: nvarchar(255)
    cantidad: int
    unidad: nvarchar(8)
    estado: nvarchar(255)
    vencimiento: date
    descripcion: nvarchar(255)
    foto: nvarchar(255)
}

entity Necesidad {
    necesidad_id (PK)
    ---
    entidad_id (FK)
    descripcion: nvarchar(255)
    ---
    fecha_inicio: date (nullable)
    fecha_fin: date (nullable, calculada)
    periodo: nvarchar(255) (nullable)
}

note right of Necesidad
  La renovación se representa en estas columnas
  de la misma fila. Sin periodo no se renueva.
  No existe una tabla de política de renovación.
end note

entity CantidadRequerida {
    necesidad_id (PK, FK)
    subcategoria_id (PK)
    ---
    cantidad_requerida: int
}

entity CantidadSuplida {
    necesidad_id (PK, FK)
    subcategoria_id (PK)
    ---
    cantidad_suplida: int
}

entity EntidadBeneficiaria {
    entidad_id (PK)
    ---
    razon_social: nvarchar(255)
    direccion: nvarchar(255)
    telefono: nvarchar(255)
}

entity Contacto {
    contacto_id (PK)
    ---
    notificable_id (FK lógica)
    tipo_notificable: nvarchar(16)
    medio_predeterminado: boolean
    ---
    valor: nvarchar(255)
    tipo_contacto: nvarchar(255)
}

entity Notificacion {
    notificacion_id (PK)
    ---
    receptor_id (referencia lógica)
    tipo_receptor: nvarchar(32)
    mensaje: nvarchar(1000)
    estado: nvarchar(32)
    fecha: datetime
}

entity Donacion {
    donacion_id (PK)
    ---
    donante_id (FK)
    entidad_id (FK)
    bien_id (FK)
    donacion_estado: nvarchar(255)
    fecha: date
}

entity RegistroCambioEstado {
    registro_id (PK)
    ---
    donacion_id (FK)
    estado_anterior: nvarchar(255)
    estado_nuevo: nvarchar(255)
    fecha: datetime
    justificacion: nvarchar(255)
}

entity Persona {
    persona_id (PK)
    ---
    tipo_doc: nvarchar(255)
    documento: nvarchar(255)
    nombre: nvarchar(255)
    usuario_id (FK)
    ultima_interaccion: datetime
}

entity PersonaJuridica {
    persona_id (PK, FK)
    ---
    razon_social: nvarchar(255)
    rubro: nvarchar(255)
}

entity PersonaHumana {
    persona_id (PK, FK)
    ---
    apellido: nvarchar(255)
    edad: int
    genero: nvarchar(255)
    direccion: nvarchar(255)
}

entity PersonaAdministradora {
    persona_administradora_id (PK)
    ---
    nombre: nvarchar(255)
}

entity Usuario {
    usuario_id (PK)
    ---
    nombre_usuario: nvarchar(255)
    contrasenia: nvarchar(255)
}

entity CorreoRepresentante {
    entidad_id (PK, FK)
    correo (PK)
}

entity SugerenciaAsignacion {
    donacion_id (PK, FK)
}

entity SugerenciaAlgoritmo {
    sugerencia_algoritmo_id (PK)
    ---
    sugerencia_id (FK)
    algoritmo: nvarchar(255)
}

entity SugerenciaAlgoritmoEntidad {
    sugerencia_algoritmo_id (PK, FK)
    entidad_id (PK, FK)
}

Persona ||--o{ Contacto
EntidadBeneficiaria ||--o{ Contacto
PersonaAdministradora ||--o{ Contacto
Persona |o--o| Usuario
Notificacion }o--|| Persona
Notificacion }o--|| EntidadBeneficiaria
Notificacion }o--|| PersonaAdministradora

Bien |o--|| Donacion

CantidadRequerida }o--|| Necesidad

CantidadSuplida }o--|| Necesidad

EntidadBeneficiaria |o--o{ Necesidad
EntidadBeneficiaria |o--o{ Donacion
EntidadBeneficiaria ||--o{ CorreoRepresentante
Persona ||--o{ Donacion

Donacion ||--o{ RegistroCambioEstado
Persona }o--o{ Persona
Donacion ||--o| SugerenciaAsignacion
SugerenciaAsignacion ||--o{ SugerenciaAlgoritmo
SugerenciaAlgoritmo ||--o{ SugerenciaAlgoritmoEntidad
EntidadBeneficiaria ||--o{ SugerenciaAlgoritmoEntidad
SugerenciaAsignacion }o--o{ EntidadBeneficiaria
Persona ||--o| PersonaHumana
Persona ||--o| PersonaJuridica
@enduml
