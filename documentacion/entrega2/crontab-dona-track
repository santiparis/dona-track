SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

DONA_TRACK_ROOT=/home/azureuser/dona-track
LOG_DIR=/home/azureuser/dona-track/logs

# Recalcula las sugerencias de asignacion cada 10 minutos.
# Se ejecuta como contenedor efimero para compartir la red y DB_URL de Compose.
*/10 * * * * cd "$DONA_TRACK_ROOT" && mkdir -p "$LOG_DIR" && flock -n "$LOG_DIR/procesador-asignaciones.lock" docker compose -f compose.yaml -f docker-compose.azure.yaml run --rm --no-deps --entrypoint java donaciones-api -cp app.jar planificacion.ProcesarAsignaciones >> "$LOG_DIR/procesador-asignaciones.log" 2>&1
