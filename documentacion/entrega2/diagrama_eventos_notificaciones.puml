package "Caso 4: Entrega No Satisfactoria" {
  class ClientEntregaNoSatisfactoria
  class EntregaNoSatisfactoriaEvent
  class EntregaNoSatisfactoriaListener

  EntregaNoSatisfactoriaListener ..|> Listener : implementa
  ClientEntregaNoSatisfactoria --> Publicador : usa
  ClientEntregaNoSatisfactoria ..> EntregaNoSatisfactoriaEvent : crea
  EntregaNoSatisfactoriaListener ..> EntregaNoSatisfactoriaEvent : procesa
  EntregaNoSatisfactoriaListener ..> Notificable : notifica >
}

@enduml
