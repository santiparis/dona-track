{{!-- Bandeja compartida por donante y entidad: el controller pasa el aviso y sus notificaciones --}}
{{#partial "contenido"}}
    <div class="encabezado">
        <h1>Notificaciones</h1>
    </div>

    {{#if notificaciones}}
        <div class="bandeja">
            {{#each notificaciones}}
                <div class="notificacion">
                    <div class="notificacion-texto">
                        <div class="row">
                            <span class="muted">{{fecha}}</span>
                        </div>
                        <p>{{mensaje}}</p>
                    </div>
                </div>
            {{/each}}
        </div>
    {{else}}
        <p class="muted">No tenés notificaciones.</p>
    {{/if}}
{{/partial}}

{{> layout}}
