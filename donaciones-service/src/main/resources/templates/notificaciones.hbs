{{!-- Bandeja compartida por donante y entidad: el controller pasa el aviso y sus notificaciones --}}
{{#partial "contenido"}}
    <div class="encabezado-con-accion">
        <h1>Notificaciones</h1>
        {{#if notificaciones}}
            <form action="/{{rol}}/notificaciones/leidas" method="post">
                <button class="btn2 chico" type="submit">Marcar todas como leídas</button>
            </form>
        {{/if}}
    </div>

    {{#if notificaciones}}
        <div class="bandeja">
            {{#each notificaciones}}
                <div class="notificacion {{#unless leida}}nueva{{/unless}}">
                    <span class="punto {{#if leida}}leido{{/if}}"></span>
                    <div class="notificacion-texto">
                        <div class="row">
                            <span class="muted">{{fecha}}</span>
                        </div>
                        <p>{{mensaje}}</p>
                    </div>
                    {{#unless leida}}
                        <form action="/{{../rol}}/notificaciones/{{id}}/leida" method="post">
                            <button class="btn2 chico" type="submit">Marcar como leída</button>
                        </form>
                    {{/unless}}
                </div>
            {{/each}}
        </div>
    {{else}}
        <p class="muted">No tenés notificaciones.</p>
    {{/if}}
{{/partial}}

{{> layout}}
