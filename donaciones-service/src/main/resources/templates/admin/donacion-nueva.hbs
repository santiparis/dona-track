{{#partial "dependencias"}}
    <script defer src="/assets/js/donacion-nueva.js"></script>
{{/partial}}

{{#partial "contenido"}}
    <h1>Registrar donación</h1>

    {{!-- Paso 1 en su propio form (GET): los forms no se pueden anidar --}}
    <section class="card">
        <h2>1. Donante</h2>
        <form class="buscador" action="/admin/donaciones/nueva" method="get">
            <label class="buscador-texto">Buscar por nombre, documento o correo<input name="donante" type="search" value="{{busqueda}}" required></label>
            <button class="btn2" type="submit">Buscar</button>
        </form>
        {{#if donante}}
            <div class="encontrado">
                <span><strong>{{donante.nombre}}</strong> · {{donante.documento}} · {{donante.email}}</span>
            </div>
        {{else if resultados}}
            {{!-- Un recuadro por resultado en vez de una tabla, para que el botón Elegir se vea en el celular --}}
            {{#each resultados}}
                <div class="encontrado">
                    <span><strong>{{nombre}}</strong> · {{documento}} · {{email}}</span>
                    <a class="btn2 chico" href="/admin/donaciones/nueva?elegido={{id}}">Elegir</a>
                </div>
            {{/each}}
        {{else if busqueda}}
            <div class="encontrado">
                <span>No hay un donante con ese nombre, documento o correo.</span>
                <a href="/admin/donantes/nuevo">Registrar donante</a>
            </div>
        {{/if}}
    </section>

    {{!-- Paso 2: los bienes se cargan de a uno en el recuadro "bien" y se suman a la tabla (donacion-nueva.js).
          Cada fila lleva sus datos en inputs ocultos: el submit final manda todos los bienes juntos, en una sola operación --}}
    <form class="card" action="/admin/donaciones" method="post" enctype="multipart/form-data">
        <input type="hidden" name="donante" value="{{donante.id}}">
        <div class="encabezado-con-accion">
            <h2 id="bienes-titulo">2. Bienes</h2>
            <button class="btn2" type="button" id="nuevo-bien" {{#unless donante}}disabled{{/unless}}>+ Agregar bien</button>
        </div>
        {{#unless donante}}<p class="hint">Primero elegí el donante.</p>{{/unless}}
        <label>Descripción general (opcional)<input name="descripcion" placeholder="Ej: mobiliario de oficina usado"></label>

        {{!-- Los campos del bien no tienen name: no viajan en el submit, los copia el JS a la fila de la tabla --}}
        <fieldset id="bien" hidden>
            <legend id="bien-titulo">Nuevo bien</legend>
            <div class="f2">
                <label>Subcategoría
                    <select id="bien-subcategoria">
                        <option value="">Elegí una subcategoría</option>
                        {{#each categorias}}
                            <optgroup label="{{texto}}">
                                {{#each subcategorias}}
                                    <option value="{{valor}}" {{#if requiereEstado}}data-estado="si" {{/if}} {{#if requiereVencimiento}}data-vence="si"{{/if}} data-unidad="{{unidad}}">{{texto}}</option>
                                {{/each}}
                            </optgroup>
                        {{/each}}
                    </select>
                </label>
                <label>Cantidad<span class="con-unidad"><input id="bien-cantidad" type="number" min="1"><output id="bien-unidad"></output></span></label>
            </div>
            <div class="f3">
                <label>Descripción<input id="bien-descripcion" placeholder="Ej: sillas de oficina"></label>
                <label id="campo-estado">Estado
                    <select id="bien-estado">
                        <option value="">Elegí</option>
                        <option value="NUEVO">Nuevo</option>
                        <option value="USADO">Usado</option>
                    </select>
                </label>
                <label id="campo-vencimiento">Vencimiento<input id="bien-vencimiento" type="date"></label>
            </div>
            <label>Foto del bien (opcional)
                <input id="bien-foto" type="file" accept="image/jpeg,image/png">
            </label>
            <p class="hint">JPG o PNG, hasta 5 MB. Se guarda en Azure Blob Storage.</p>
            <p class="error-form" id="bien-error" role="alert" hidden></p>
            <div class="row">
                <button class="btn" type="button" id="agregar-bien">Agregar a la lista</button>
                <button class="btn2" type="button" id="cancelar-bien">Cancelar</button>
            </div>
        </fieldset>

        <div class="tbl">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Subcategoría</th>
                        <th scope="col">Cantidad</th>
                        <th scope="col">Detalle</th>
                        <th scope="col">Foto</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody id="bienes"></tbody>
            </table>
        </div>
        <p class="muted" id="sin-bienes">Todavía no agregaste bienes.</p>

        <p class="aviso">Al guardar se genera una donación por cada subcategoría (y por fecha de vencimiento en perecederos). Todas quedan “En depósito”.</p>
        <div class="row acciones">
            <a class="btn2" href="/admin/donaciones">Cancelar</a>
            <button class="btn" type="submit" id="registrar" disabled>Registrar donación</button>
        </div>
    </form>
{{/partial}}

{{> layout}}
