{{#partial "contenido"}}
    <div class="encabezado-con-accion">
        <h1>Donaciones en depósito</h1>
        <a class="btn" href="/admin/donaciones/nueva">Registrar donación</a>
    </div>

    <form class="buscador" action="/admin/donaciones" method="get">
        {{!-- Mismo formato que en Registrar donación: la categoría es el título y se elige la subcategoría --}}
        <label class="buscador-filtro">Subcategoría
            <select name="subcategoria">
                <option value="">Todas</option>
                {{#each categorias}}
                    <optgroup label="{{texto}}">
                        {{#each subcategorias}}
                            <option value="{{valor}}" {{#if (eq valor ../../subcategoriaElegida)}}selected{{/if}}>{{texto}}</option>
                        {{/each}}
                    </optgroup>
                {{/each}}
            </select>
        </label>
        <label class="buscador-filtro">Vencimiento
            <select name="vence">
                <option value="">Cualquiera</option>
                <option value="VENCIDA" {{#if (eq venceElegido "VENCIDA")}}selected{{/if}}>Vencidas</option>
            </select>
        </label>
        <button class="btn" type="submit">Filtrar</button>
        <a class="btn2" href="/admin/donaciones">Limpiar filtros</a>
    </form>

    {{#if donaciones}}
        <div class="tbl">
            <table>
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Bien</th>
                        <th scope="col">Foto</th>
                        <th scope="col">Cantidad</th>
                        <th scope="col">Donante</th>
                        <th scope="col">Ingreso</th>
                        <th scope="col">Vence</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each donaciones}}
                        <tr>
                            <td>{{id}}</td>
                            <td>{{bien}}</td>
                            <td>{{#if fotoBienUrl}}<img class="foto-mini" src="{{fotoBienUrl}}" alt="Foto de {{bien}}" loading="lazy">{{else}}—{{/if}}</td>
                            <td>{{cantidad}}</td>
                            <td>{{donante}}</td>
                            <td>{{ingreso}}</td>
                            <td>
                                {{#if (eq vencimiento "VENCIDA")}}
                                    <span class="vencida">{{vence}} · vencida</span>
                                {{else}}
                                    {{vence}}
                                {{/if}}
                            </td>
                            {{!-- Solo las perecederas que no están vencidas se pueden marcar --}}
                            <td>
                                {{#if (eq vencimiento "NO_APLICA")}}
                                    <span class="muted">—</span>
                                {{else if (eq vencimiento "VENCIDA")}}
                                    <span class="muted">—</span>
                                {{else}}
                                    <form action="/admin/donaciones/{{id}}/vencida" method="post">
                                        <button class="btn2 chico peligro" type="submit">Marcar vencida</button>
                                    </form>
                                {{/if}}
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    {{else}}
        <p class="muted">No hay donaciones en depósito con esos filtros.</p>
    {{/if}}
{{/partial}}

{{> layout}}
