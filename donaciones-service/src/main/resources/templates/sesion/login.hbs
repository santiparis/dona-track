{{#partial "contenido"}}
    <div class="form-chico">
        <form class="card" action="/login" method="post">
            <h1>Iniciar sesión</h1>
            <p class="muted">Para donantes, entidades beneficiarias y personas administradoras.</p>
            {{#if registroExitoso}}
                <p class="aviso" role="status">Tu cuenta fue creada. Ya podés iniciar sesión con tu correo electrónico.</p>
            {{/if}}
            {{#if error}}
                <p class="error-form" role="alert">{{error}}</p>
            {{/if}}
            <label>Usuario o correo electrónico<input name="usuario" type="text" value="{{nombreUsuario}}" autocomplete="username" required></label>
            <label>Contraseña<span class="con-ojo"><input name="password" type="password" autocomplete="current-password" required><button class="ojo" type="button" aria-label="Mostrar contraseña" aria-pressed="false" onclick="const i = this.previousElementSibling; i.type = i.type === 'password' ? 'text' : 'password'; this.setAttribute('aria-pressed', i.type === 'text')"><svg class="ojo-abierto" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><svg class="ojo-tachado" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/><path d="M3 3l18 18"/></svg></button></span></label>
            <button class="btn" type="submit">Ingresar</button>
            <p class="muted centrado">¿No tenés cuenta? <a href="/usuarios/nuevo">Registrate</a></p>
        </form>
    </div>
{{/partial}}

{{> layout}}
