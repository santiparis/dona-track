{{#partial "contenido"}}
    <div class="form-chico">
        <form class="card" action="/login" method="post">
            <h1>Iniciar sesión</h1>
            <p class="muted">Para donantes, entidades beneficiarias y personas administradoras.</p>
            <label>Correo electrónico<input name="usuario" type="email" autocomplete="username" required></label>
            <label>Contraseña<input name="password" type="password" autocomplete="current-password" required></label>
            <button class="btn" type="submit">Ingresar</button>
            <p class="muted centrado">¿No tenés cuenta? <a href="/usuarios/nuevo">Registrate</a></p>
        </form>
    </div>
{{/partial}}

{{> layout}}
