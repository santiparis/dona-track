{{#partial "contenido"}}
    <div class="encabezado">
        <h1>Crear cuenta</h1>
        <p class="muted">¿Ya tenés cuenta? <a href="/login">Iniciá sesión</a></p>
    </div>

    {{#if tipo}}
    <div><a class="volver-registro" href="/usuarios/nuevo{{#unless (eq tipo "ENTIDAD")}}?perfil=donante{{/unless}}">Volver al paso anterior</a></div>
    <form class="card" action="/usuarios" method="post">
        <input type="hidden" name="tipo" value="{{tipo}}">
        {{#if error}}<p class="error-form" role="alert">{{error}}</p>{{/if}}

        {{#if (eq tipo "ENTIDAD")}}
            <div class="bloque">
                <h2>Entidad beneficiaria</h2>
                <label>Razón social<input name="razonSocial" value="{{razonSocial}}" maxlength="255" required></label>
                <label>Dirección completa<input name="direccion" value="{{direccion}}" maxlength="255" required></label>
                <label>Correo electrónico de la cuenta<input name="email" type="email" value="{{email}}" autocomplete="username" maxlength="254" required></label>
                <label>Teléfono<input name="telefono" type="tel" value="{{telefono}}" maxlength="20" placeholder="+54 9 11 5555-5555" pattern="\+54 ?9[\d \-]{10,15}" title="Con código de país y 9, sin 0 ni 15. Ej: +54 9 11 5555-5555"></label>
                <label>Correos de representantes (opcional)<textarea name="correos" maxlength="5000">{{correos}}</textarea><span class="hint">Podés dejar este campo vacío o separar los correos con comas, punto y coma o saltos de línea.</span></label>
            </div>
        {{else}}
            {{> form-donante}}
        {{/if}}

        <fieldset>
            <legend>Acceso</legend>
            <p class="hint">Vas a ingresar con el correo electrónico de esta cuenta. La contraseña debe tener entre 8 y 128 caracteres.</p>
            <div class="f2">
                <label>Contraseña<span class="con-ojo"><input name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required><button class="ojo" type="button" aria-label="Mostrar contraseña" aria-pressed="false" onclick="const i = this.previousElementSibling; i.type = i.type === 'password' ? 'text' : 'password'; this.setAttribute('aria-pressed', i.type === 'text')"><svg class="ojo-abierto" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><svg class="ojo-tachado" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/><path d="M3 3l18 18"/></svg></button></span></label>
                <label>Repetir contraseña<span class="con-ojo"><input name="password2" type="password" autocomplete="new-password" minlength="8" maxlength="128" required><button class="ojo" type="button" aria-label="Mostrar contraseña" aria-pressed="false" onclick="const i = this.previousElementSibling; i.type = i.type === 'password' ? 'text' : 'password'; this.setAttribute('aria-pressed', i.type === 'text')"><svg class="ojo-abierto" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><svg class="ojo-tachado" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/><path d="M3 3l18 18"/></svg></button></span></label>
            </div>
        </fieldset>

        <label class="radio"><input type="checkbox" name="acepta" {{#if acepta}}checked{{/if}} required>Acepto los <a href="/legal">términos y la política de privacidad</a></label>
        <div class="row acciones">
            <a class="btn2" href="/">Cancelar</a>
            <button class="btn" type="submit">Crear cuenta</button>
        </div>
    </form>
    {{else}}
    <section class="card">
        {{#if error}}<p class="error-form" role="alert">{{error}}</p>{{/if}}
        {{#if eligeDonante}}
            <h2>¿Donás como persona humana o jurídica?</h2>
            <div class="row">
                <a class="btn" href="/usuarios/nuevo?tipo=HUMANA">Persona humana</a>
                <a class="btn" href="/usuarios/nuevo?tipo=JURIDICA">Persona jurídica</a>
            </div>
            <div><a class="volver-registro" href="/usuarios/nuevo">Volver al paso anterior</a></div>
        {{else}}
            <h2>¿Cómo querés participar?</h2>
            <div class="row">
                <a class="btn" href="/usuarios/nuevo?perfil=donante">Soy donante</a>
                <a class="btn" href="/usuarios/nuevo?tipo=ENTIDAD">Quiero recibir donaciones</a>
            </div>
        {{/if}}
    </section>
    {{/if}}
{{/partial}}

{{> layout}}
