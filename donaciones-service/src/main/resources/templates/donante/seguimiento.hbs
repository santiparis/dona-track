{{#partial "contenido"}}
    <div class="encabezado-con-accion">
        <div class="encabezado">
            <h1>Seguimiento de entregas</h1>
            <p class="muted">Camiones que hoy llevan donaciones tuyas.</p>
        </div>
        <a class="btn2" href="/donante/seguimiento">Actualizar</a>
    </div>

    <div class="mapa">
        <div class="ph">
            <span>Mapa en tiempo real — próxima iteración</span>
            <span class="muted">Un marcador por camión y los destinos de tus donaciones</span>
        </div>
    </div>

    {{#if camiones}}
        <div class="tbl">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Camión</th>
                        <th scope="col">Tu donación</th>
                        <th scope="col">Destino</th>
                        <th scope="col">Ubicación</th>
                        <th scope="col">Velocidad</th>
                        <th scope="col">Última actualización</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each camiones}}
                        <tr>
                            <td>{{patente}}</td>
                            <td>{{donacion}}</td>
                            <td>{{destino}}</td>
                            <td>{{ubicacion}}</td>
                            <td>{{velocidad}}</td>
                            <td>{{actualizacion}}</td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    {{else}}
        <p class="muted">No hay entregas activas de tus donaciones en este momento.</p>
    {{/if}}
{{/partial}}

{{> layout}}
