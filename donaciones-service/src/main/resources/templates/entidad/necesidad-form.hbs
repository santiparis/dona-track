{{#partial "contenido"}}
    <h1>{{titulo}}</h1>

    {{!-- Con necesidad.id el formulario edita esa necesidad; sin id, da de alta una nueva --}}
    <form class="card" action="/entidad/necesidades{{#if necesidad.id}}/{{necesidad.id}}{{/if}}" method="post">
        {{!-- Recurrente y extraordinaria en el mismo formulario: el tipo elegido muestra sus campos (ver form.css) --}}
        <fieldset>
            <legend>Tipo de necesidad</legend>
            <div class="row">
                <label class="radio"><input type="radio" name="tipo" value="EXTRAORDINARIA" {{#unless (eq tipo "RECURRENTE")}}checked{{/unless}}>Extraordinaria</label>
                <label class="radio"><input type="radio" name="tipo" value="RECURRENTE" {{#if (eq tipo "RECURRENTE")}}checked{{/if}}>Recurrente</label>
            </div>
            <p class="hint solo-extraordinaria">Situación excepcional (mudanza, inundación, incendio). Se satisface al alcanzar la cantidad, aunque llegue en partes.</p>
            <p class="hint solo-recurrente">Consumo habitual: la cantidad objetivo se renueva cada período.</p>
        </fieldset>

        <div class="f2">
            <label>Subcategoría
                <select name="subcategoria">
                    {{#each categorias}}
                        <optgroup label="{{texto}}">
                            {{#each subcategorias}}
                                <option value="{{valor}}" {{#if (eq valor ../../necesidad.subcategoria)}}selected{{/if}}>{{texto}}</option>
                            {{/each}}
                        </optgroup>
                    {{/each}}
                </select>
            </label>
            <label>Cantidad<input name="cantidad" type="number" min="1" value="{{necesidad.cantidad}}" required></label>
        </div>
        <label>Descripción breve<input name="descripcion" placeholder="Ej: reposición de bancos tras la inundación" value="{{necesidad.descripcion}}"></label>
        <div class="f2">
            <label>Desde<input name="fechaInicio" type="date"></label>
            <label class="solo-recurrente">Período
                <select name="periodo">
                    <option value="SEMANAL" {{#if (eq necesidad.periodo "SEMANAL")}}selected{{/if}}>Semanal</option>
                    <option value="MENSUAL" {{#if (eq necesidad.periodo "MENSUAL")}}selected{{/if}}>Mensual</option>
                </select>
            </label>
            <label class="solo-extraordinaria">Hasta (opcional)<input name="fechaFin" type="date"></label>
        </div>
        <div class="row acciones">
            <a class="btn2" href="/entidad/necesidades">Cancelar</a>
            <button class="btn" type="submit">Guardar necesidad</button>
        </div>
    </form>
{{/partial}}

{{> layout}}
