{{#partial "contenido"}}
    <div class="encabezado-con-accion">
        <h1>Mis necesidades</h1>
        <a class="btn" href="/entidad/necesidades/nueva">Registrar necesidad</a>
    </div>

    {{#if necesidades}}
        <div class="tbl">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Subcategoría</th>
                        <th scope="col">Descripción</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Avance</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each necesidades}}
                        <tr>
                            <td>{{subcategoriaTexto}}</td>
                            <td>{{descripcion}}</td>
                            <td><span class="chip">{{tipoTexto}}</span></td>
                            <td>
                                <div class="avance">
                                    <div class="bar" role="img" aria-label="{{avance}}"><span style="width: {{porcentaje}}%"></span></div>
                                    <span>{{avance}}</span>
                                    {{#if (eq cubierta "true")}}<span class="chip ok">Cubierta</span>{{/if}}
                                </div>
                            </td>
                            <td>
                                <div class="acciones-tabla">
                                    <a class="btn2 chico" href="/entidad/necesidades/nueva?editar={{id}}">Editar</a>
                                    <form action="/entidad/necesidades/{{id}}/eliminar" method="post">
                                        <button class="btn2 chico peligro" type="submit">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    {{else}}
        <p class="muted">Todavía no registraste necesidades.</p>
    {{/if}}
{{/partial}}

{{> layout}}
