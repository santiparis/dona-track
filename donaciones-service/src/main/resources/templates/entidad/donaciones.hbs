{{#partial "contenido"}}
    <h1>Donaciones asignadas</h1>

    <form class="buscador" action="/entidad/donaciones" method="get">
        <label class="buscador-filtro">Estado
            <select name="estado">
                <option value="">Todos</option>
                {{#each estados}}
                    <option value="{{valor}}" {{#if (eq valor ../estadoElegido)}}selected{{/if}}>{{texto}}</option>
                {{/each}}
            </select>
        </label>
        <button class="btn" type="submit">Filtrar</button>
    </form>

    {{#if donaciones}}
        <div class="tbl">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Bien</th>
                        <th scope="col">Cantidad</th>
                        <th scope="col">Donante</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Actualizado</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each donaciones}}
                        <tr>
                            <td>{{bien}}</td>
                            <td>{{cantidad}}</td>
                            <td>{{donante}}</td>
                            <td><span class="chip {{estado}}">{{estadoTexto}}</span></td>
                            <td>{{actualizado}}</td>
                            {{!-- La acción depende del estado: solo lo que está en traslado se puede confirmar --}}
                            <td>
                                {{#if (eq estado "EN_TRASLADO")}}
                                    <a class="btn chico" href="/entidad/donaciones/{{id}}/recepcion">Confirmar recepción</a>
                                {{else if (eq estado "LISTA_PARA_ENTREGAR")}}
                                    <a class="btn2 chico" href="/entidad/seguimiento">Ver seguimiento</a>
                                {{else if (eq estado "ENTREGA_FALLIDA")}}
                                    <span class="muted">Vuelve al depósito</span>
                                {{/if}}
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    {{else}}
        <p class="muted">No hay donaciones con ese estado.</p>
    {{/if}}
{{/partial}}

{{> layout}}
