{{!-- El renderer agrega la cuenta autenticada al encabezado de todas las páginas. --}}
<header class="hdr">
    <a class="logo" href="{{#if (eq rol "donante")}}/donante/donaciones{{else if (eq rol "entidad")}}/entidad/necesidades{{else if (eq rol "admin")}}/admin/donaciones{{else}}/{{/if}}">
        <img class="logo-box" src="/assets/img/logo.svg" alt="">DonaTrack{{#if (eq rol "admin")}} · Administración{{/if}}
    </a>

    {{!-- Cada rol tiene sus links en su propio partial (nav-*.hbs) --}}
    <nav class="nav" aria-label="Principal">
        {{#if (eq rol "donante")}}
            {{> nav-donante}}
        {{else if (eq rol "entidad")}}
            {{> nav-entidad}}
        {{else if (eq rol "admin")}}
            {{!-- El admin navega con el menú lateral (menu-admin.hbs) --}}
        {{else}}
            {{> nav-publico}}
        {{/if}}
    </nav>

    {{#if usuario}}
        <div class="user">
            {{!-- Campanita de notificaciones: solo donante y entidad tienen bandeja --}}
            {{#if rol}}{{#unless (eq rol "admin")}}
                <a class="campana" href="/{{rol}}/notificaciones" aria-label="Notificaciones" {{#if (eq seccion "notificaciones")}}aria-current="page"{{/if}}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                    {{#if usuario.notificacionesSinLeer}}<span class="badge" aria-label="{{usuario.notificacionesSinLeer}} sin leer">{{usuario.notificacionesSinLeer}}</span>{{/if}}
                </a>
            {{/unless}}{{/if}}
            <span>{{usuario.nombre}}</span>
            <form action="/logout" method="post">
                <button class="btn2 chico" type="submit">Cerrar sesión</button>
            </form>
        </div>
    {{else}}
        <div class="row">
            {{#unless (eq seccion "login")}}
                <a class="btn2" href="/login">Iniciar sesión</a>
            {{/unless}}
            {{#unless (eq seccion "registro")}}
                <a class="btn" href="/usuarios/nuevo">Registrarme</a>
            {{/unless}}
        </div>
    {{/if}}
</header>
