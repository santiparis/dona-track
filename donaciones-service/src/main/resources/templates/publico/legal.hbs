{{#partial "contenido"}}
    <div class="angosto">
        <div class="encabezado">
            <h1>Información legal y de privacidad</h1>
            <p class="muted">Última actualización: [FECHA]</p>
        </div>

        <nav class="toc" aria-label="Secciones">
            <a href="#terminos">Términos de uso</a>
            <a href="#privacidad">Privacidad</a>
            <a href="#datos">Tus datos personales</a>
            <a href="#contacto">Contacto</a>
        </nav>

        <section id="terminos" class="card">
            <h2>Términos de uso</h2>
            <p class="muted">[Texto de términos y condiciones a definir por el equipo]</p>
        </section>
        <section id="privacidad" class="card">
            <h2>Política de privacidad</h2>
            <p class="muted">[Qué datos se recolectan: datos de registro, medios de contacto, fotos de entregas. Para qué se usan: asignar y entregar donaciones, enviar notificaciones.]</p>
        </section>
        <section id="datos" class="card">
            <h2>Tus datos personales</h2>
            <p class="muted">[Derechos de acceso, rectificación y supresión según la Ley 25.326 de Protección de Datos Personales.]</p>
        </section>
        <section id="contacto" class="card">
            <h2>Contacto</h2>
            <p class="muted">[CORREO DE CONTACTO]</p>
        </section>
    </div>
{{/partial}}

{{> layout}}
