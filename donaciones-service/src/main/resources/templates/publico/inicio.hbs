{{#partial "contenido"}}
    <section class="hero">
        <div class="hero-texto">
            <h1>Tu donación, de punta a punta</h1>
            <p class="muted">DonaTrack gestiona las donaciones que llegan al depósito y las asigna a escuelas, comedores y organizaciones que las necesitan. Cada donación se puede seguir desde que se recibe hasta que se entrega.</p>
            <div class="row">
                <a class="btn cta" href="/usuarios/nuevo">Quiero donar</a>
                <a class="btn2" href="/usuarios/nuevo">Registrar mi entidad</a>
            </div>
        </div>
        <div class="ph">Imagen principal</div>
    </section>

    <section class="seccion">
        <h2>Nuestros objetivos</h2>
        <div class="cols">
            <div class="card"><h3>Trazabilidad</h3><p class="muted">Cada donación registra su estado: en depósito, asignada, en traslado y entregada.</p></div>
            <div class="card"><h3>Asignación según necesidades</h3><p class="muted">Las donaciones se asignan a las entidades según lo que declararon necesitar.</p></div>
            <div class="card"><h3>Entregas visibles</h3><p class="muted">Donantes y entidades siguen el recorrido del camión hasta la entrega.</p></div>
        </div>
    </section>

    <section class="seccion">
        <h2>Cómo funciona</h2>
        <div class="cols">
            <div class="card"><span class="num">1</span><h3>Llevás tu donación al depósito</h3><p class="muted">Una persona administradora la registra a tu nombre.</p></div>
            <div class="card"><span class="num">2</span><h3>Se asigna a una entidad</h3><p class="muted">Te avisamos a qué entidad va tu donación.</p></div>
            <div class="card"><span class="num">3</span><h3>Seguís la entrega</h3><p class="muted">La entidad confirma la recepción con fotos.</p></div>
        </div>
    </section>

    <section class="card banner">
        <div class="banner-texto">
            <h2>Mirá lo que ya entregamos</h2>
            <p class="muted">Fotos y mapa de las donaciones entregadas, sin necesidad de iniciar sesión.</p>
        </div>
        <a class="btn" href="/donaciones-entregadas">Ver donaciones entregadas</a>
    </section>
{{/partial}}

{{> layout}}
