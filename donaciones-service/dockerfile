# Etapa 1: compilar
FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /app

COPY pom.xml ./pom.xml
COPY donaciones-service/pom.xml ./donaciones-service/pom.xml
COPY donaciones-service/src ./donaciones-service/src

RUN mvn -f donaciones-service/pom.xml clean package -DskipTests

# Etapa 2: ejecutar
FROM eclipse-temurin:17-jre

WORKDIR /app

COPY --from=builder \
    /app/donaciones-service/target/donaciones-api-jar-with-dependencies.jar \
    app.jar

EXPOSE 8081

CMD ["java", "-jar", "app.jar"]